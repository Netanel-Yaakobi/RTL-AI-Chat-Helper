{
  "manifest_version": 3,
  "name": "RTL AI Chat Helper",
  "version": "1.0.0",
  "description": "Unofficial RTL helper for AI chat websites with smart Hebrew support.",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RTL AI Chat Helper",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": [
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*"
      ],
      "js": ["src/defaults.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
